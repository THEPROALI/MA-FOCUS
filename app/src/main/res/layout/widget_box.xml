<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_round" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:maxLines="1" />
        <TextView android:id="@+id/w_main" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="22sp" android:textStyle="bold" android:maxLines="2" />
        <TextView android:id="@+id/w_bar" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/w_l1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_l2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_l3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_l4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_l5" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
